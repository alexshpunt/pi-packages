{
  "name": "@buyong/pi-claude-compact",
  "version": "0.1.0",
  "description": "Claude Code's context compaction, rebuilt for Pi: partial-preserve engine, 9-section summary prompt, post-compact restore, failure breakers, and background precompute.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction",
    "claude-code"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "commands.ts",
    "config.ts",
    "controller.ts",
    "engine.ts",
    "pi-settings.ts",
    "precompute.ts",
    "prompt.ts",
    "restore.ts",
    "session-state.ts",
    "summarizer.ts",
    "thresholds.ts",
    "transcript.ts",
    "CHANGELOG.md",
    "CHANGELOG.ko.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "biome check --write . && tsgo --noEmit",
    "lint": "biome check .",
    "typecheck": "tsgo --noEmit",
    "format": "biome format --write ."
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
